# LiveClipper configuration template.
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
# The ".env" file is git-ignored and must NEVER be committed.

# --- Twitch application credentials (from https://dev.twitch.tv/console) ---
# Client ID is public-ish; Client Secret is sensitive. Keep both out of chat/logs.
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match an OAuth Redirect URL registered on your Twitch app.
# Used later for the chat (user token) login. Safe to leave as-is.
TWITCH_REDIRECT_URI=http://localhost:3000

# --- Discovery settings ---
# The game/category name to search for. Resolved to a category ID at runtime
# (never hardcoded). Change this if the category is named differently on Twitch.
GTA6_CATEGORY_NAME=Grand Theft Auto VI

# How many live streams to list at most (1-100).
MAX_STREAMS=20

# Optional: only show streams in this language (e.g. "en"). Leave blank for all.
STREAM_LANGUAGE=

# --- Chat spike detection (all optional; sensible defaults shown) ---
# Rolling window for "current" message rate, in seconds.
SPIKE_WINDOW_SECONDS=10
# Fire a spike when current rate >= this many times the baseline rate.
SPIKE_MULTIPLIER=3
# Require at least this many messages in the window (avoids false positives).
SPIKE_MIN_MESSAGES=10
# Minimum seconds between spike alerts.
SPIKE_COOLDOWN_SECONDS=15
# Ignore spikes until this many seconds of baseline data have been collected.
SPIKE_WARMUP_SECONDS=30

# --- Candidate highlight events (all optional; defaults shown) ---
# Seconds of chat context captured BEFORE the spike moment.
EVENT_PRE_SECONDS=10
# Seconds of chat collected AFTER the spike before the event closes.
EVENT_POST_SECONDS=20
# How much each emote in a message amplifies its activity weight (0 = ignore).
EMOTE_WEIGHT=0.5
# Hard cap on a single merged event's duration (seconds).
MAX_EVENT_SECONDS=120

# --- Gemini AI Highlight Intelligence (Stage 4) ---
# Get an API key from https://aistudio.google.com/apikey
# Keep this secret — never commit .env or print it in logs.
GEMINI_API_KEY=your_gemini_api_key_here

# Enable or disable Gemini analysis in monitor_chat.py (true/false).
# If GEMINI_API_KEY is left blank or placeholder, monitor_chat.py falls back to
# detection-only mode automatically.
GEMINI_ENABLED=true

# Gemini model to use for runtime chat highlight analysis.
GEMINI_MODEL=gemini-3.1-flash-lite

# Per-request timeout (seconds) and transient error retry limit.
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# Async queue bounds, concurrency, and rate-limit ceiling.
GEMINI_QUEUE_MAX_SIZE=20
GEMINI_MAX_CONCURRENCY=2
GEMINI_MAX_CALLS_PER_MINUTE=10

# Maximum chat messages included in each prompt (keeps latency & cost bounded).
GEMINI_MAX_MESSAGES=120

# Post-validation clip recommendation thresholds (applied on top of Gemini output).
GEMINI_MIN_CLIP_SCORE=65
GEMINI_MIN_CONFIDENCE=0.6

# Local JSONL file where analyzed highlight records are appended (git-ignored).
HIGHLIGHTS_OUTPUT_PATH=highlights.jsonl

# --- Stage 5: Live Video Capture, Rolling Buffer & Clip Planning (optional) ---
# Disabled by default so Stage 1-4 scripts continue running without FFmpeg/Streamlink.
RECORDING_ENABLED=false
RECORDING_QUALITY=1080p60,1080p,720p60,best
RECORDING_LOW_LATENCY=true
RECORDING_SEGMENT_SECONDS=4
RECORDING_BUFFER_SECONDS=300
RECORDING_MAX_BUFFER_MB=500
RECORDING_MAX_ACTIVE_PINS=10
RECORDING_PIN_MAX_TTL_SECONDS=180
RECORDING_GAP_TOLERANCE_SECONDS=1.5
RECORDING_BUFFER_DIR=.buffer

# Heuristic chat-to-video offset and clip window bounds (seconds).
# CLIP_REACTION_OFFSET_SECONDS is an approximate heuristic, not exact sync.
CLIP_REACTION_OFFSET_SECONDS=6.0
CLIP_PRE_SECONDS=12.0
CLIP_POST_SECONDS=18.0
CLIP_MAX_DURATION_SECONDS=90.0
CLIP_REENCODE=true
CLIPS_OUTPUT_DIR=clips

# --- Stage 6: Multi-Stream Orchestration (optional) ---
# Default target channels to monitor (comma-separated Twitch logins).
# Overridden by CLI arguments: python monitor_streams.py channel1 channel2
# If left blank, monitor_streams.py can discover live channels with --auto.
TARGET_CHANNELS=

# Enable multi-stream recording (true/false).
# When false (default), monitor_streams.py monitors only the first channel in TARGET_CHANNELS.
# When true, monitors all channels up to MAX_CONCURRENT_STREAMS concurrently.
MULTI_STREAM_ENABLED=false

# Maximum concurrent live stream sessions active at any one time (1-100).
MAX_CONCURRENT_STREAMS=3

# Global disk budget (in megabytes) across all stream rolling buffers combined.
# Oldest unpinned segments from active sessions are pruned when this budget is exceeded.
# Pinned segments and active recordings are never deleted.
MAX_TOTAL_BUFFER_MB=1500

# Global semaphore bounding concurrent FFmpeg clip extractions across all streams.
MAX_CONCURRENT_EXTRACTIONS=2

# Interval in seconds between batched Twitch Helix liveness checks.
# Offline channels have their individual sessions stopped; sessions resume when streams return.
LIVENESS_POLL_SECONDS=60

# --- Stage 7: YouTube Shorts Integration & Upload (optional) ---
# Directory where processed vertical shorts and sidecars land (e.g. shorts/<channel>/).
SHORTS_OUTPUT_DIR=shorts

# Vertical reframing engine: auto | openshorts | ffmpeg_fallback
# auto: attempts OpenShorts (via Docker or Python 3.11) and falls back to native FFmpeg if unavailable.
# openshorts: requires OpenShorts and fails if not available.
# ffmpeg_fallback: always uses the pure FFmpeg blur-pad and hook overlay engine.
SHORTS_ENGINE=auto

# Maximum duration in seconds for YouTube Shorts.
# Clips over this threshold are automatically trimmed to 55s centered on target_pts.
SHORTS_MAX_DURATION=59.0

# Google OAuth 2.0 Client credentials from Google Cloud Console (Desktop application).
# Required only if you intend to upload generated shorts to YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Default privacy status for uploaded YouTube Shorts: private, unlisted, or public.
# 'public' is the default for automated publication.
YOUTUBE_PRIVACY_STATUS=public

# If true, high-scoring highlights meeting YOUTUBE_MIN_SCORE can be auto-uploaded.
# Set to false to require manual review/approval via CLI.
YOUTUBE_AUTO_UPLOAD=false

# Minimum Gemini highlight score (0-100) required for automatic upload.
YOUTUBE_MIN_SCORE=75

# Maximum number of video uploads allowed per calendar day to preserve API quota.
# YouTube Data API v3 charges 1,600 units per video insert against a 10,000 unit daily quota.
YOUTUBE_DAILY_LIMIT=5

# Path to the file storing OAuth refresh tokens (chmod 0600, git-ignored).
YOUTUBE_TOKENS_PATH=.youtube_tokens.json

# --- Stage 8: Full OpenShorts Docker Integration (optional) ---
# Tag or name of the built OpenShorts Docker image.
OPENSHORTS_DOCKER_IMAGE=liveclipper/openshorts:latest

# Maximum execution timeout in seconds for containerized OpenShorts processing.
OPENSHORTS_DOCKER_TIMEOUT=600.0

# Subtitle styling preset for burned-in word-level animated captions:
# bold | default | hormozi | pill | lime | oneword | cine | clean | none
OPENSHORTS_SUBTITLE_STYLE=bold

# Vertical reframing layout mode:
# auto: MediaPipe intelligent multi-layout (split/wide/track per scene)
# split: force top-bottom split view
# track: force active speaker tracking
# wide: force blurred-background wide view
OPENSHORTS_REFRAME_MODE=auto

# --- Stage 9: YouTube Viral Metadata Optimization Engine (optional) ---
# Enable AI-driven viral title, description, and tag generation using Gemini.
# If false or if Gemini API is unreachable, deterministic viral templates are used.
VIRAL_METADATA_ENABLED=true

# Gemini model used for creative viral metadata generation (titles, description, tags).
VIRAL_METADATA_MODEL=gemini-2.5-flash

# Allow emojis in generated viral titles (e.g. 💀, 😂, 🔥).
VIRAL_TITLE_EMOJI=true

# Primary language for generated titles and descriptions.
VIRAL_TITLE_LANGUAGE=en

# --- Stage 10: Multi-Platform, Video Quality & Language Filtering (optional) ---
# Platform to monitor: twitch | youtube | all
MONITOR_PLATFORM=all

# Priority YouTube channel IDs to check for live streams (comma-separated).
# Default includes top gaming streamers (CarryMinati, Mortal, Techno Gamerz, etc.).
TARGET_YOUTUBE_CHANNELS=UC7cs8q-gJRlGwj4A8OmCmXg,UCvQ0C-sIKKlFaxyHYRE1YSg,UCsiddxZ6V4Flv-s3nps49AQ,UCG4eH77kG_X9F0w_dE7g1rg,UCjqF3HPUPi_1c64LpD2w0_g,UC0pA8_YvGqQx-r4C7d2P6FA,UCXfJ48U5G1T5k-p8G9f5J9A,UClvgJrkf4k4Kq2R4H8_wB9g

# Enable or disable automatic language filtering before monitoring streams.
LANGUAGE_FILTER_ENABLED=true

# Target languages to accept (comma-separated codes). Streams in other languages are skipped.
TARGET_LANGUAGES=en,hi

# Video encoding bitrate and CRF for YouTube Shorts rendering.
SHORTS_OUTPUT_BITRATE=6M
SHORTS_OUTPUT_CRF=18

# YouTube live chat polling interval in seconds (respects API quotas).
YOUTUBE_CHAT_POLL_INTERVAL=2.0

# Auto-approve discovered fallback streams when no target channels are live (default: false).
# When false, LiveClipper waits for user approval via the Dashboard before recording.
AUTO_APPROVE_FALLBACK=false
MAX_CONCURRENT_STREAMS=2



