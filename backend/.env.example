# LiveClipper Configuration
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
# The ".env" file is git-ignored and must NEVER be committed.

# ============================================
# YouTube API Credentials
# ============================================
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Desktop app)
# Required for: live chat monitoring, stream discovery, and Shorts upload.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Gemini AI API Key
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ============================================
# YouTube Target Channels
# ============================================
# Priority YouTube channel IDs to monitor (comma-separated).
# These are checked first before falling back to category discovery.
TARGET_YOUTUBE_CHANNELS=

# Auto-approve discovered fallback streams when no target channels are live.
# When false (default), waits for user approval via the Dashboard.
AUTO_APPROVE_FALLBACK=false

# ============================================
# Stream Monitoring
# ============================================
# Enable/disable multi-stream recording.
# false = monitor only 1 stream. true = monitor up to MAX_CONCURRENT_STREAMS.
MULTI_STREAM_ENABLED=false

# Maximum concurrent live stream sessions (1-10).
MAX_CONCURRENT_STREAMS=2

# Enable live video recording (true/false).
# When false, only chat monitoring and Gemini analysis run (no video capture).
RECORDING_ENABLED=true

# Preferred recording quality (Streamlink quality string).
RECORDING_QUALITY=1080p60,1080p,720p60,best

# ============================================
# Chat Spike Detection
# ============================================
SPIKE_WINDOW_SECONDS=10
SPIKE_MULTIPLIER=3
SPIKE_MIN_MESSAGES=10
SPIKE_COOLDOWN_SECONDS=15
SPIKE_WARMUP_SECONDS=30

# ============================================
# Highlight Event Settings
# ============================================
EVENT_PRE_SECONDS=10
EVENT_POST_SECONDS=20
EMOTE_WEIGHT=0.5
MAX_EVENT_SECONDS=120

# ============================================
# Gemini AI Highlight Intelligence
# ============================================
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_QUEUE_MAX_SIZE=20
GEMINI_MAX_CONCURRENCY=2
GEMINI_MAX_CALLS_PER_MINUTE=10
GEMINI_MAX_MESSAGES=120
GEMINI_MIN_CLIP_SCORE=65
GEMINI_MIN_CONFIDENCE=0.6
HIGHLIGHTS_OUTPUT_PATH=highlights.jsonl

# ============================================
# Recording & Buffer Settings
# ============================================
RECORDING_LOW_LATENCY=true
RECORDING_SEGMENT_SECONDS=4
RECORDING_BUFFER_SECONDS=300
RECORDING_MAX_BUFFER_MB=500
RECORDING_MAX_ACTIVE_PINS=10
RECORDING_PIN_MAX_TTL_SECONDS=180
RECORDING_GAP_TOLERANCE_SECONDS=1.5
RECORDING_BUFFER_DIR=.buffer

# ============================================
# Clip Extraction Settings
# ============================================
CLIP_REACTION_OFFSET_SECONDS=6.0
CLIP_PRE_SECONDS=12.0
CLIP_POST_SECONDS=18.0
CLIP_MAX_DURATION_SECONDS=90.0
CLIP_REENCODE=true
CLIPS_OUTPUT_DIR=clips

# ============================================
# Multi-Stream Resource Limits
# ============================================
# Global disk budget (MB) across all stream rolling buffers.
MAX_TOTAL_BUFFER_MB=1500

# Max concurrent FFmpeg clip extractions across all streams.
MAX_CONCURRENT_EXTRACTIONS=2

# Interval (seconds) between YouTube liveness checks.
LIVENESS_POLL_SECONDS=60

# ============================================
# Shorts Processing
# ============================================
# Output directory for processed vertical Shorts.
SHORTS_OUTPUT_DIR=shorts

# Processing engine: auto | openshorts | ffmpeg_fallback
SHORTS_ENGINE=auto

# Max duration for YouTube Shorts (clips over this are trimmed to 55s).
SHORTS_MAX_DURATION=59.0

# Max concurrent clip processing tasks (Whisper + FFmpeg).
MAX_CONCURRENT_PROCESSING=2

# Video encoding for Shorts.
SHORTS_OUTPUT_BITRATE=6M
SHORTS_OUTPUT_CRF=18

# ============================================
# Vertical Reframing & Subtitles
# ============================================
# Layout: split (facecam top, gameplay bottom) | wide | track | auto
OPENSHORTS_REFRAME_MODE=split

# Subtitle style: bold | pill | hormozi | clean | cine | none
OPENSHORTS_SUBTITLE_STYLE=bold

# Burn hook title banner into video (true/false). Default false.
HOOK_OVERLAY_ENABLED=false

# ============================================
# YouTube Upload Settings
# ============================================
# Default privacy: private | unlisted | public
YOUTUBE_PRIVACY_STATUS=public

# Auto-upload clips meeting minimum score without manual review.
YOUTUBE_AUTO_UPLOAD=false

# Minimum Gemini score (0-100) required for upload.
YOUTUBE_MIN_SCORE=75

# Max uploads per day (YouTube API: 1,600 units per upload, 10,000 daily limit).
YOUTUBE_DAILY_LIMIT=5

# Max concurrent YouTube uploads.
MAX_CONCURRENT_UPLOADS=3

# OAuth token file path (git-ignored).
YOUTUBE_TOKENS_PATH=.youtube_tokens.json

# Upload encoding quality (higher = better quality after YouTube re-encode).
YOUTUBE_UPLOAD_BITRATE=12M
YOUTUBE_UPLOAD_CRF=15
YOUTUBE_UPLOAD_AUDIO_BITRATE=256k

# ============================================
# Viral Metadata Engine
# ============================================
VIRAL_METADATA_ENABLED=true
VIRAL_METADATA_MODEL=gemini-2.5-flash
VIRAL_TITLE_EMOJI=true
VIRAL_TITLE_LANGUAGE=en

# ============================================
# Language Filtering
# ============================================
LANGUAGE_FILTER_ENABLED=true
TARGET_LANGUAGES=en,hi

# YouTube live chat polling interval (seconds).
YOUTUBE_CHAT_POLL_INTERVAL=2.0

# ============================================
# YouTube Video Importer
# ============================================
IMPORT_MAX_CLIPS=5
IMPORT_CLIP_DURATION=55
IMPORT_SKIP_INTRO=0
IMPORT_SKIP_OUTRO=0
IMPORT_DOWNLOAD_QUALITY=1080

# ============================================
# Discovery (for category-based stream search)
# ============================================
GTA6_CATEGORY_NAME=Grand Theft Auto VI
MAX_STREAMS=20
STREAM_LANGUAGE=